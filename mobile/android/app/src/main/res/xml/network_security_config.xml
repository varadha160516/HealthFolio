<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9+ (targetSdk 28+, which this app uses) blocks plain HTTP by default. This app's
  documented local-dev setup (README.md "Pointing it at a backend") talks to a plain-HTTP
  CareLoop server on the emulator alias 10.0.2.2 or a LAN IP, so cleartext is explicitly
  permitted here. A real deployment should point API_BASE_URL at an HTTPS backend instead —
  HTTPS traffic is unaffected by this file either way, so nothing here needs to change for that.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
