# Copy this file to .env (in this same server/ folder) and fill in your key to turn on real
# vision-LLM extraction (Section 4.3) instead of the mock adapter. Never commit the real .env —
# it's already covered by the repo's .gitignore.

# Required for real extraction. Get one at https://console.anthropic.com/ (needs billing enabled —
# each uploaded document is a real API call and costs real money once this is set).
ANTHROPIC_API_KEY=

# Optional overrides — defaults shown are fine for most use.
# CARELOOP_EXTRACTION_MODEL=claude-sonnet-5
# CARELOOP_MATCH_MODEL=claude-sonnet-5
# PORT=4000
