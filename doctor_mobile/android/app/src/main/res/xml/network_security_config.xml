<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9+ (targetSdk 28+, which this app uses) blocks plain HTTP by default. The backend is
  currently a plain-HTTP EC2 instance (no TLS termination yet), so cleartext is explicitly
  permitted here — mirrors mobile/'s own network_security_config.xml. Once the backend gets a
  domain + HTTPS in front of it, API_BASE_URL should move to that instead; this file can stay
  either way since HTTPS traffic is unaffected by it.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
